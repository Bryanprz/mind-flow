<% content_for :title, "Dashboard - MindFlow" %>
<% content_for :hide_footer, true %>
<% content_for :vite_page, true %>

<div class="w-full h-screen authenticated-theme tech-grid with-bg-image overflow-hidden relative">
  <!-- Background Image -->
  <div class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-30" 
       style="background-image: url('https://images.unsplash.com/photo-1446776877081-d282a0f896e2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2072&q=80');">
  </div>
  
  <!-- Content Overlay -->
  <div class="relative z-10 w-full h-full">
    <div id="react-dashboard" data-current-user="<%= Current.user.to_json %>" class="w-full h-full"></div>
  </div>
</div>