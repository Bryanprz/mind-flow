<% content_for :vite_page, true %>

<div class="min-h-screen bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 p-8">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-white mb-4">Chart Library Comparison</h1>
      <p class="text-xl text-blue-200">Visx vs D3 + Observable Plot</p>
    </div>

    <!-- Chart Comparison Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Visx Chart -->
      <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 border border-white/20">
        <h2 class="text-2xl font-bold text-white mb-4 flex items-center gap-2">
          <span class="text-2xl">📊</span>
          Visx Implementation
        </h2>
        <div class="h-96 bg-black/20 rounded-lg p-4 overflow-hidden">
          <div id="visx-chart" data-react-component="StatisticsChartVisx" class="h-full"></div>
        </div>
        <div class="mt-4 text-sm text-gray-300">
          <p><strong>Features:</strong> Modular components, React-native, customizable</p>
          <p><strong>Performance:</strong> Fast rendering, optimized for React</p>
        </div>
      </div>

      <!-- D3 + Observable Plot Chart -->
      <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 border border-white/20">
        <h2 class="text-2xl font-bold text-white mb-4 flex items-center gap-2">
          <span class="text-2xl">🎨</span>
          D3 + Observable Plot
        </h2>
        <div class="h-96 bg-black/20 rounded-lg p-4 overflow-hidden">
          <div id="d3-chart" data-react-component="StatisticsChartD3" class="h-full"></div>
        </div>
        <div class="mt-4 text-sm text-gray-300">
          <p><strong>Features:</strong> Powerful D3 ecosystem, Observable Plot integration</p>
          <p><strong>Performance:</strong> Advanced data visualization, flexible</p>
        </div>
      </div>
    </div>

    <!-- Comparison Table -->
    <div class="mt-12 bg-white/10 backdrop-blur-sm rounded-xl p-6 border border-white/20">
      <h3 class="text-2xl font-bold text-white mb-6">Library Comparison</h3>
      <div class="overflow-x-auto">
        <table class="w-full text-white">
          <thead>
            <tr class="border-b border-white/20">
              <th class="text-left py-3 px-4">Feature</th>
              <th class="text-left py-3 px-4">Visx</th>
              <th class="text-left py-3 px-4">D3 + Observable</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-white/10">
              <td class="py-3 px-4 font-medium">Learning Curve</td>
              <td class="py-3 px-4 text-green-400">Easy</td>
              <td class="py-3 px-4 text-yellow-400">Moderate</td>
            </tr>
            <tr class="border-b border-white/10">
              <td class="py-3 px-4 font-medium">Customization</td>
              <td class="py-3 px-4 text-green-400">High</td>
              <td class="py-3 px-4 text-green-400">Very High</td>
            </tr>
            <tr class="border-b border-white/10">
              <td class="py-3 px-4 font-medium">Performance</td>
              <td class="py-3 px-4 text-green-400">Excellent</td>
              <td class="py-3 px-4 text-green-400">Excellent</td>
            </tr>
            <tr class="border-b border-white/10">
              <td class="py-3 px-4 font-medium">React Integration</td>
              <td class="py-3 px-4 text-green-400">Native</td>
              <td class="py-3 px-4 text-yellow-400">Manual</td>
            </tr>
            <tr class="border-b border-white/10">
              <td class="py-3 px-4 font-medium">Bundle Size</td>
              <td class="py-3 px-4 text-green-400">Modular</td>
              <td class="py-3 px-4 text-yellow-400">Larger</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium">Best For</td>
              <td class="py-3 px-4 text-blue-300">React apps, quick setup</td>
              <td class="py-3 px-4 text-purple-300">Complex visualizations, data science</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Navigation -->
    <div class="mt-8 text-center">
      <a href="/dashboard" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
        <span>←</span>
        Back to Dashboard
      </a>
    </div>
  </div>
</div>

<%= vite_javascript_tag 'chart_comparison.jsx' %>
