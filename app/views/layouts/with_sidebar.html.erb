<!DOCTYPE html>
<html class="h-full m-0 p-0">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} - MindFlow" : "MindFlow" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <% unless content_for?(:vite_page) %>
      <%= javascript_importmap_tags %>
    <% else %>
      <%= vite_client_tag %>
      <%= vite_javascript_tag 'entrypoints/dashboard.jsx' %>
    <% end %>
    
    <!-- Load Tailwind CSS -->
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    
    <!-- Layout styles: app/assets/stylesheets/layouts/_drawer.css -->
    
    <%= yield :head %>
  </head>

  <body class="h-screen bg-gray-900 overflow-hidden m-0 p-0 authenticated-theme tech-grid">
    <!-- Background Image for entire layout -->
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-30" 
         style="background-image: url('https://images.unsplash.com/photo-1446776877081-d282a0f896e2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2072&q=80');">
    </div>
    
    <div class="drawer drawer-open w-full h-full m-0 p-0 relative z-10">
      <input id="sidebar-toggle" type="checkbox" class="drawer-toggle" checked />
      
      <!-- Sidebar -->
      <%= render 'shared/sidebar' %>
      
      <!-- Main Content -->
      <div class="drawer-content w-full h-full m-0 p-0">
        <%= yield %>
      </div>
    </div>
  </body>
</html>
