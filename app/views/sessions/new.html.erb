<% content_for :title, "Sign In - MindFlow" %>
<% content_for :hide_navigation, true %>

<div class="min-h-screen w-full bg-gradient-to-br from-gray-900 via-gray-800 to-black flex items-center justify-center p-6 relative overflow-hidden">
  <!-- NASA-style space background effects -->
  <div class="fixed inset-0 bg-[radial-gradient(circle_at_center,rgba(6,182,212,0.1)_0%,transparent_50%)] pointer-events-none"></div>
  <div class="fixed inset-0 bg-[radial-gradient(circle_at_80%_20%,rgba(168,85,247,0.08)_0%,transparent_50%)] pointer-events-none"></div>
  
  <!-- Animated stars -->
  <div class="fixed inset-0 pointer-events-none">
    <div class="absolute w-1 h-1 bg-white rounded-full top-[10%] left-[20%] animate-pulse"></div>
    <div class="absolute w-1 h-1 bg-white rounded-full top-[30%] left-[60%] animate-pulse animation-delay-500"></div>
    <div class="absolute w-1 h-1 bg-white rounded-full top-[60%] left-[30%] animate-pulse animation-delay-1000"></div>
    <div class="absolute w-1 h-1 bg-white rounded-full top-[80%] left-[80%] animate-pulse animation-delay-1500"></div>
    <div class="absolute w-1 h-1 bg-cyan-400 rounded-full top-[20%] left-[80%] animate-pulse animation-delay-800"></div>
    <div class="absolute w-1 h-1 bg-purple-400 rounded-full top-[70%] left-[10%] animate-pulse animation-delay-1200"></div>
  </div>

  <!-- Sign In Card -->
  <div class="w-full max-w-md relative z-10">
    <!-- Header -->
    <div class="text-center mb-8">
      <div class="flex items-center justify-center gap-3 mb-4">
        <div class="w-16 h-16 bg-gradient-to-br from-cyan-500 to-purple-500 rounded-xl flex items-center justify-center shadow-lg shadow-cyan-400/20">
          <span class="text-white text-2xl font-bold">M</span>
        </div>
      </div>
      <h1 class="text-4xl font-bold text-white tracking-wide mb-2">MISSION ACCESS</h1>
      <p class="text-cyan-400 text-sm">Enter credentials to access cognitive optimization platform</p>
    </div>

    <!-- Alert Messages -->
    <% if alert = flash[:alert] %>
      <div class="mb-6 bg-red-500/20 backdrop-blur-sm border border-red-500/30 rounded-lg p-4">
        <p class="text-red-300 text-sm font-medium" id="alert"><%= alert %></p>
      </div>
    <% end %>

    <% if notice = flash[:notice] %>
      <div class="mb-6 bg-emerald-500/20 backdrop-blur-sm border border-emerald-500/30 rounded-lg p-4">
        <p class="text-emerald-300 text-sm font-medium" id="notice"><%= notice %></p>
      </div>
    <% end %>

    <!-- Sign In Form -->
    <div class="bg-black/60 backdrop-blur-sm rounded-xl p-8 border border-gray-700/30 shadow-2xl">
      <%= form_with url: session_url, data: { turbo: false } do |form| %>
        <div class="space-y-6">
          <!-- Email Field -->
          <div>
            <label class="block text-white font-semibold mb-2">
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"></path>
                </svg>
                Email Address
              </span>
            </label>
            <%= form.email_field :email_address, 
                required: true, 
                autofocus: true, 
                autocomplete: "username", 
                placeholder: "commander@mindflow.space", 
                value: params[:email_address], 
                class: "w-full bg-gray-800 border border-gray-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20 transition-all duration-200" %>
          </div>

          <!-- Password Field -->
          <div>
            <label class="block text-white font-semibold mb-2">
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                </svg>
                Access Code
              </span>
            </label>
            <%= form.password_field :password, 
                required: true, 
                autocomplete: "current-password", 
                placeholder: "Enter your access code", 
                maxlength: 72, 
                class: "w-full bg-gray-800 border border-gray-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20 transition-all duration-200" %>
          </div>

          <!-- Submit Button -->
          <div>
            <%= form.submit "Initiate Access", 
                class: "w-full bg-gradient-to-r from-cyan-500 to-purple-500 hover:from-cyan-600 hover:to-purple-600 text-white font-semibold py-3 px-6 rounded-lg transition-all duration-200 shadow-lg shadow-cyan-400/20 hover:shadow-cyan-400/30 cursor-pointer" %>
          </div>

          <!-- Forgot Password Link -->
          <div class="text-center">
            <%= link_to new_password_path, class: "text-cyan-400 hover:text-cyan-300 text-sm transition-colors inline-flex items-center gap-2" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Forgot Access Code?
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Footer -->
    <div class="text-center mt-6">
      <p class="text-gray-400 text-sm">
        Secure connection established
        <span class="inline-flex items-center gap-1 ml-2">
          <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path>
          </svg>
          <span class="text-emerald-400 text-xs">Encrypted</span>
        </span>
      </p>
    </div>
  </div>
</div>
