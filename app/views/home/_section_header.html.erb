<%# Section Header Partial
  title: String (can include HTML for styling)
  subtitle: String
  classes: String (optional additional classes)
%>
<div class="text-center mb-16 <%= classes %>">
  <h2 class="futuristic-title text-4xl lg:text-5xl font-bold text-white mb-6">
    <%= title %>
  </h2>
  <% if subtitle %>
    <p class="text-xl text-blue-200 max-w-3xl mx-auto">
      <%= subtitle %>
    </p>
  <% end %>
</div>
