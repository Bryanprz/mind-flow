<div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 border border-white/20 <%= 'opacity-75' if goal.completed? %> transition-all duration-200 hover:bg-white/15">
  <div class="flex items-start justify-between mb-4">
    <div class="flex-1">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-12 h-12 bg-gradient-to-br from-blue-500/20 to-purple-500/20 rounded-lg flex items-center justify-center">
          <span class="text-2xl"><%= goal.icon || '🎯' %></span>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-white">
            <%= goal.title %>
          </h3>
          <% if goal.completed? %>
            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-500/20 text-green-400 border border-green-500/30">
              ✓ Completed
            </span>
          <% elsif goal.overdue? %>
            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-500/20 text-red-400 border border-red-500/30">
              Overdue
            </span>
          <% end %>
        </div>
      </div>
      
      <% if goal.category.present? %>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-700/50 text-gray-300 border border-gray-600/50">
          <%= goal.category %>
        </span>
      <% end %>
      
      <% if goal.deadline %>
        <p class="text-gray-400 text-sm mt-3 flex items-center gap-2">
          <% if goal.overdue? %>
            <span class="text-red-400">⏰</span>
            Deadline was <%= goal.deadline.strftime("%B %d, %Y") %>
          <% elsif goal.days_until_deadline %>
            <span class="text-blue-400">📅</span>
            <%= goal.days_until_deadline %> days remaining (<%= goal.deadline.strftime("%b %d") %>)
          <% else %>
            <span class="text-blue-400">📅</span>
            <%= goal.deadline.strftime("%B %d, %Y") %>
          <% end %>
        </p>
      <% end %>
    </div>
    
    <div class="flex gap-2">
      <%= link_to edit_goal_path(goal), class: "w-8 h-8 bg-blue-500/20 hover:bg-blue-500/30 rounded-lg flex items-center justify-center transition-all duration-200 group" do %>
        <span class="text-blue-400 group-hover:text-blue-300">✏️</span>
      <% end %>
      <%= button_to goal_path(goal), method: :delete, 
          data: { turbo_confirm: "Are you sure you want to delete this goal?" },
          class: "w-8 h-8 bg-red-500/20 hover:bg-red-500/30 rounded-lg flex items-center justify-center transition-all duration-200 group" do %>
        <span class="text-red-400 group-hover:text-red-300">🗑️</span>
      <% end %>
    </div>
  </div>

  <% if goal.description.present? %>
    <p class="text-gray-300 text-sm mb-4 leading-relaxed"><%= goal.description %></p>
  <% end %>

  <div class="space-y-3">
    <div class="flex justify-between items-center">
      <span class="text-gray-400 text-sm font-medium">Progress</span>
      <span class="text-white font-bold text-sm"><%= goal.progress %> / <%= goal.target %></span>
    </div>
    <div class="w-full bg-gray-700/50 rounded-full h-3 overflow-hidden">
      <div class="<%= goal.completed? ? 'bg-gradient-to-r from-green-400 to-green-500' : 'bg-gradient-to-r from-blue-400 to-purple-500' %> h-3 rounded-full transition-all duration-500 ease-out" 
           style="width: <%= [goal.progress_percentage, 100].min %>%"></div>
    </div>
    <div class="flex justify-between items-center">
      <span class="text-xs text-gray-500">Progress</span>
      <span class="text-sm <%= goal.completed? ? 'text-green-400' : 'text-blue-400' %> font-semibold">
        <%= goal.progress_percentage %>% Complete
      </span>
    </div>
  </div>
</div>

