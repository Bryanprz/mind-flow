<% content_for :title, "My Goals - MindFlow" %>

<div class="h-full bg-gradient-to-br from-gray-900 via-blue-900 to-purple-900 overflow-auto" style="overflow: scroll;">
  <!-- Header -->
  <div class="bg-black/20 backdrop-blur-sm border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold text-white flex items-center gap-3">
            <span class="text-4xl">🎯</span>
            My Goals
          </h1>
          <p class="text-blue-300 mt-2">Track your progress and achieve your targets</p>
        </div>
        <div class="flex items-center gap-4">
          <%= link_to "New Goal", new_goal_path, class: "btn bg-gradient-to-r from-blue-500 to-purple-600 hover:from-blue-600 hover:to-purple-700 text-white border-0 rounded-lg px-6 py-3 font-semibold transition-all duration-200" %>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- Active Goals -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-2">
        <span class="text-3xl">⚡</span>
        Active Goals
      </h2>
      <% if @active_goals.any? %>
        <div class="grid md:grid-cols-2 gap-6">
          <% @active_goals.each do |goal| %>
            <%= render 'goal_card', goal: goal %>
          <% end %>
        </div>
      <% else %>
        <div class="bg-white/10 backdrop-blur-sm rounded-xl p-8 border border-white/20 text-center">
          <div class="text-6xl mb-4">🎯</div>
          <h3 class="text-xl font-semibold text-white mb-2">No active goals yet</h3>
          <p class="text-gray-400 mb-6">Start your journey by creating your first goal</p>
          <%= link_to "Create Your First Goal", new_goal_path, class: "btn bg-gradient-to-r from-blue-500 to-purple-600 hover:from-blue-600 hover:to-purple-700 text-white border-0 rounded-lg px-6 py-3 font-semibold transition-all duration-200" %>
        </div>
      <% end %>
    </div>

    <!-- Completed Goals -->
    <% if @completed_goals.any? %>
      <div>
        <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-2">
          <span class="text-3xl">🎉</span>
          Completed Goals
        </h2>
        <div class="grid md:grid-cols-2 gap-6">
          <% @completed_goals.each do |goal| %>
            <%= render 'goal_card', goal: goal %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

