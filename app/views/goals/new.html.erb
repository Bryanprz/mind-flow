<% content_for :title, "New Goal - MindFlow" %>

<div class="max-w-2xl mx-auto px-4 py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-white mb-2">Create New Goal</h1>
    <p class="text-gray-400">Set a new cognitive performance goal to track your progress</p>
  </div>

  <div class="card bg-base-100 border border-gray-700">
    <div class="card-body">
      <%= render 'form', goal: @goal %>
    </div>
  </div>
</div>

